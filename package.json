{
  "name": "@puwenhui/dsh-email",
  "version": "0.3.2",
  "description": "DSH 邮件助手插件：IMAP 同步 + 全文索引 + 会话归并 + 10 个模型工具 + 设置配置卡 + 重要新邮件桌面提醒",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Puwenhui-Me/dsh-email.git"
  },
  "homepage": "https://github.com/Puwenhui-Me/dsh-email#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "lib/plugin.mjs",
  "exports": {
    ".": "./lib/plugin.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "USAGE.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "imapflow": "^1.0.196",
    "mailparser": "^3.7.4",
    "nodemailer": "^9.0.6"
  },
  "license": "MIT"
}
